# OpenAI API key
# 取得方式：OpenAI Platform -> API keys
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_OPENAI_API_KEY

# 主要回覆模型。請填 OpenAI API 可用的 model id。
# 可查：https://platform.openai.com/docs/models
OPENAI_MODEL=gpt-5.4-mini

# 是否啟用 LLM 回覆判斷器。
# true：先讓另一個模型判斷是否值得回覆，再產生回覆。
# false：通過冷卻與機率判斷後直接產生回覆。
LLM_REPLY_FILTER_ENABLED=false

# LLM 回覆判斷器使用的模型。通常可用較便宜、較快的模型。
LLM_REPLY_FILTER_MODEL=gpt-4.1-mini

# system prompt 檔案路徑。
# 若不設定，程式預設使用 prompt/system_prompt.txt。
PROMPT_PATH=prompt/system_prompt.txt

# Bot 帳號的 Twitch OAuth token。
# 取得方式可用 Twitch CLI：
# twitch token --user-token --scopes "user:read:chat user:write:chat"
# 也可以用自己的 OAuth flow 產生 user access token。
# 注意：這個 token 必須屬於 TWITCH_BOT_ID 對應的 Twitch 帳號。
TWITCH_TOKEN=oauth:REPLACE_WITH_YOUR_TWITCH_OAUTH_TOKEN
#TWITCH_TOKEN=oauth:REPLACE_WITH_ANOTHER_TWITCH_OAUTH_TOKEN

# 頻道登入名稱，目前主要用於 log 顯示。
# 例如頻道網址 https://www.twitch.tv/topa_1120 的 login 是 topa_1120。
TWITCH_CHANNEL=CHANNEL_LOGIN_NAME

# Twitch Developer Console 應用程式的 Client ID。
# 取得方式：https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=REPLACE_WITH_YOUR_TWITCH_CLIENT_ID

# Client Secret 也可在 Twitch Developer Console 的同一個 app 頁面取得。
# 目前 main.py 主要使用 TWITCH_TOKEN 登入；一般情況可先保持註解。
#TWITCH_CLIENT_SECRET=REPLACE_WITH_YOUR_TWITCH_CLIENT_SECRET

# Bot 帳號的 Twitch user ID。
# 取得方式：用 Helix Get Users 查 bot 帳號 login，回傳的 id 就是 user ID。
# curl -H "Client-ID: <TWITCH_CLIENT_ID>" -H "Authorization: Bearer <TOKEN>" \
#   "https://api.twitch.tv/helix/users?login=<bot_login>"
TWITCH_BOT_ID=REPLACE_WITH_BOT_USER_ID


# 要監聽的直播主 / 頻道擁有者 Twitch user ID。
# 取得方式同 TWITCH_BOT_ID，只是 login 改成目標頻道的 login。
# 這個值實際決定 EventSub 監聽哪個頻道。
TWITCH_OWNER_ID=REPLACE_WITH_CHANNEL_OWNER_USER_ID

# Bot 在 console log 中顯示的名稱。
# Twitch 上實際發話帳號由 TWITCH_TOKEN 決定，不由這個值決定。
TWITCH_BOT_NICK=聊天機器人

# true：通過忽略規則與冷卻後都回覆。
# false：依 REPLY_PROBABILITY 隨機回覆，除非訊息包含強制觸發詞。
ALWAYS_REPLY=true

# ALWAYS_REPLY=false 時的隨機回覆機率。0.5 代表 50%。
REPLY_PROBABILITY=0.5

# 一般觀眾強制觸發詞，多個詞用半形逗號分隔。
# 訊息包含任一觸發詞時，會略過隨機回覆機率，但仍會檢查冷卻與 LLM 回覆判斷器。
FORCE_TRIGGERS=小助手,bot,@小助手

# 台主強制觸發詞。
# TWITCH_OWNER_ID 發出的訊息預設會被忽略，只有包含此詞時才會強制回覆並且強迫BOT執行命令。
OWNER_FORCE_TRIGGER=@小助手

# Bot 兩次公開回覆之間的全域冷卻秒數。
GLOBAL_COOLDOWN_SECONDS=10

# 同一使用者兩次被回覆之間的冷卻秒數。
USER_COOLDOWN_SECONDS=30

# 超過此長度的聊天室訊息會被忽略。
MAX_INPUT_LENGTH=150

# GPT 回覆超過此長度會被截斷。
MAX_REPLY_LENGTH=120
